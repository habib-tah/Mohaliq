{
  "name": "mohaliq-ai-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",

  "vars": {
   "MODEL": "gemini-3.6-flash"
  },

  "ratelimits": [
    {
      "name": "PER_DEVICE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
